{
  "name": "roadtrip-planner",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "dev": "concurrently -n shared,api,web -c cyan,magenta,yellow \"pnpm --dir packages/shared run dev\" \"pnpm --dir packages/api run dev\" \"pnpm --dir packages/web run dev\"",
    "build": "tsc -b && pnpm --filter @roadtrip/web build",
    "build:clean": "tsc -b --clean",
    "type-check": "pnpm --filter @roadtrip/shared build && pnpm -r --bail exec tsc --noEmit",
    "format": "pnpm exec prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,md}\" && markdownlint-cli2 --fix \"**/*.md\" \"!**/node_modules/**\"",
    "format:check": "pnpm exec prettier --check \"packages/**/*.{ts,tsx,js,jsx,json,md}\" && markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\"",
    "lint": "pnpm -r --bail run lint",
    "test": "pnpm -r --bail run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.1.0",
    "markdownlint-cli2": "^0.22.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "keywords": [],
  "author": "Laury Baillon",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "better-sqlite3",
      "esbuild",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-react-hooks>eslint": "10",
        "vite-plugin-pwa>vite": "8",
        "ts-jest>typescript": "6"
      }
    }
  }
}
